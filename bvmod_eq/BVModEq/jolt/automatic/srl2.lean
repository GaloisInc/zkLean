lemma srl_2_mle_one_chunk_liza[ZKField f] (bv1 bv2 : BitVec 8) (fv1 fv2 : Vector f 8) :
  some bvoutput = BVModEq.map_f_to_bv 32 foutput ->
   some (BVModEq.bool_to_bv 32 bv1[7])  = BVModEq.map_f_to_bv 32 fv1[0]  ->
   some (BVModEq.bool_to_bv 32 bv1[6]) = BVModEq.map_f_to_bv 32 fv1[1]  ->
   some (BVModEq.bool_to_bv 32 bv1[5]) = BVModEq.map_f_to_bv 32 fv1[2]  ->
   some (BVModEq.bool_to_bv 32 bv1[4]) = BVModEq.map_f_to_bv 32 fv1[3]  ->
   some (BVModEq.bool_to_bv 32 bv1[3]) = BVModEq.map_f_to_bv 32 fv1[4]  ->
  some (BVModEq.bool_to_bv 32 bv1[2]) = BVModEq.map_f_to_bv 32 fv1[5]  ->
   some (BVModEq.bool_to_bv 32 bv1[1]) = BVModEq.map_f_to_bv 32 fv1[6]  ->
   some (BVModEq.bool_to_bv 32 bv1[0]) = BVModEq.map_f_to_bv 32 fv1[7]  ->
  some (BVModEq.bool_to_bv 32 bv2[7]) = BVModEq.map_f_to_bv 32 fv2[0]  ->
  some (BVModEq.bool_to_bv 32 bv2[6]) = BVModEq.map_f_to_bv 32 fv2[1]  ->
  some (BVModEq.bool_to_bv 32 bv2[5]) = BVModEq.map_f_to_bv 32 fv2[2]  ->
  some (BVModEq.bool_to_bv 32 bv2[4]) = BVModEq.map_f_to_bv 32 fv2[3]  ->
  some (BVModEq.bool_to_bv 32 bv2[3]) = BVModEq.map_f_to_bv 32 fv2[4]  ->
  some (BVModEq.bool_to_bv 32 bv2[2]) = BVModEq.map_f_to_bv 32 fv2[5]  ->
  some (BVModEq.bool_to_bv 32 bv2[1]) = BVModEq.map_f_to_bv 32 fv2[6]  ->
  some (BVModEq.bool_to_bv 32 bv2[0]) = BVModEq.map_f_to_bv 32 fv2[7]  ->
  bv2[7] = false ->
  bv2[6] = false ->
  bv2[5] = false ->
  (bvoutput = (((bv1.zeroExtend 32) <<< 16 ) >>> bv2.toNat).zeroExtend 32)
  =
  (foutput = evalSubtable SRL2_16 (Vector.append fv1 fv2)) := by
  unfold SRL2_16
  unfold evalSubtable
  unfold subtableFromMLE
  unfold Vector.append
  translate_all false
